{
  "name": "safehaven-contracts",
  "version": "1.0.0",
  "description": "SafeHeaven Smart Contracts with ERC-2771 Meta-transactions",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "npx hardhat run scripts/deploy.js --network mainnet",
    "deploy-and-register:local": "npx hardhat run scripts/deploy-and-register.js --network localhost",
    "deploy-and-register:sepolia": "npx hardhat run scripts/deploy-and-register.js --network sepolia",
    "node": "npx hardhat node"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.0.0",
    "hardhat": "^2.27.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1"
  }
}
